<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>127.0.0.1</address>
                <address>192.168.127.101</address>
                <address>192.168.10.200</address>
            </interfaceWhiteList>
                <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>

        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
            <segment_size>3198400</segment_size>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="booster_dds" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
                <transport_id>shm_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
              <builtin>
                  <discovery_config>
                      <!-- FIX: evict the notebook participant 10s after cable pull
                           so its locators are removed from the routing table -->
                      <leaseDuration>
                          <sec>10</sec>
                      </leaseDuration>
                      <leaseAnnouncement>
                          <sec>3</sec>
                      </leaseAnnouncement>
                  </discovery_config>
              </builtin>
        </rtps>
    </participant>

    <publisher profile_name="default publisher profile" is_default_profile="true">
        <qos>
            <data_sharing>
                <kind>AUTOMATIC</kind>
            </data_sharing>
        </qos>
    </publisher>

    <subscriber profile_name="default subscription profile" is_default_profile="true">
        <qos>
            <data_sharing>
                <kind>AUTOMATIC</kind>
            </data_sharing>
        </qos>
    </subscriber>
</profiles>