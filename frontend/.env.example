# Supabase Configuration
# You can find these in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Robot Connection (Optional - defaults listed below)
# The IP address of your robot running the ROS2 stack
# NEXT_PUBLIC_ROS_IP=192.168.1.95
# The port for the ROS bridge WebSocket (default 9090)
# NEXT_PUBLIC_ROS_PORT=9090

# App Configuration
# The URL of your frontend application
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# BotBrain Edition
# Set to 'pro' for professional features, leave empty/unset for Open Source edition
# BOTBRAIN_EDITION=oss
